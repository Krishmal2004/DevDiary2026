PORT=4000
BACKEND_BASE_URL=http://localhost:4000

GITHUB_APP_ID=4993144
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
GITHUB_PRIVATE_KEY_PATH=./keys/devdiary2026.private-key.pem
# The app's URL name: https://github.com/apps/<slug>
GITHUB_APP_SLUG=devdiary2026
# Must match the webhook secret in the GitHub App settings.
GITHUB_WEBHOOK_SECRET=replace_with_a_random_string

SESSION_SECRET=replace_with_a_long_random_string

DATABASE_PATH=./data/devdiary.sqlite

# Email reminders. Leave EMAIL_API_KEY unset to print emails to the console.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your_email_provider_api_key
EMAIL_FROM=reminders@yourdomain.com

# How often to check for due todos (cron syntax). Default: every minute.
REMINDER_CRON=* * * * *

APP_BASE_URL=http://localhost:5173

# The VS Code extension's ID (<publisher>.<name>). Only its URI handler may
# receive sign-in codes. Default: krishmal2004.devdiary2026
# VSCODE_EXTENSION_ID=krishmal2004.devdiary2026
